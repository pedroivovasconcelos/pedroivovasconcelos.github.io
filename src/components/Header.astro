---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  isErrorPage?: boolean;
}

const { isErrorPage = false } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    {isErrorPage ? (
      <a class="brand" href="/" aria-label="Pedro Ivo Vasconcelos — página inicial">
        <span class="brand-mark" aria-hidden="true">PI</span>
        <span>Pedro Ivo</span>
      </a>
    ) : (
      <a class="brand" href="#inicio" aria-label="Pedro Ivo Vasconcelos — início">
        <span class="brand-mark" aria-hidden="true">PI</span>
        <span>Pedro Ivo</span>
      </a>
    )}

    {isErrorPage ? (
      <ThemeToggle />
    ) : (
      <nav class="main-nav" aria-label="Navegação principal">
        <a href="#sobre">Sobre</a>
        <a href="#projetos">Projetos</a>
        <a href="#atuacao">Atuação</a>
        <a href="#contato">Contato</a>
        <ThemeToggle />
      </nav>
    )}
  </div>
</header>
