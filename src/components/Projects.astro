---
import ProjectCard from './ProjectCard.astro';
---

<section class="section" id="projetos" aria-labelledby="projetos-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Projetos em destaque</p>
        <h2 id="projetos-title">Produtos com propósitos diferentes, unidos por clareza.</h2>
      </div>
      <p>
        Uma seleção de experiências públicas desenvolvidas entre dados, IA e
        interação.
      </p>
    </div>

    <div class="project-grid">
      <ProjectCard
        index="01"
        type="Decisão · colaboração"
        title="Farolio"
        description="Um espaço colaborativo que transforma informações financeiras em decisões claras e próximas ações."
        linkHref="https://farolio.vercel.app/"
        linkText="Visitar Farolio"
        featured={true}
      />
      <ProjectCard
        index="02"
        type="Viagens · IA"
        title="SternaWay"
        description="Planejamento de viagens com IA, com rotas que podem se tornar blueprints públicos e reutilizáveis."
        linkHref="https://sternaway.vercel.app/"
        linkText="Visitar SternaWay"
      />
      <ProjectCard
        index="03"
        type="Web · experiência"
        title="SternaFly"
        description="Uma aventura aérea 2.5D em pixel-voxel criada para a web."
        linkHref="https://sternafly.web.app/"
        linkText="Visitar SternaFly"
      />
    </div>
  </div>
</section>
