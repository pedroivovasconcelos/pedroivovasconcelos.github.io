---
import StudioCard from './StudioCard.astro';
---

<section class="hero section" id="inicio" aria-labelledby="hero-title">
  <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">IA aplicada · automação · dados</p>
      <h1 id="hero-title">Ideias que ganham forma como produtos digitais.</h1>
      <p class="hero-lead">
        Sou Pedro Ivo Vasconcelos. Conecto tecnologia, clareza e visão de produto
        para criar experiências digitais úteis e preparadas para evoluir.
      </p>
      <p class="english-summary" lang="en">
        I build thoughtful AI-enabled products at the intersection of automation,
        data and user experience.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projetos">Conhecer projetos</a>
        <a
          class="button button-secondary"
          href="https://www.linkedin.com/in/pedro-ivo-vasconcelos-bb4632a5/"
        >
          Ver LinkedIn
        </a>
      </div>
    </div>

    <StudioCard />
  </div>
</section>
