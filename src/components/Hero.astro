---
import StudioCard from './StudioCard.astro';
---

<section class="hero section" id="inicio" aria-labelledby="hero-title">
  <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Data Platform Engineering · Reliability · Applied AI</p>
      <h1 id="hero-title">Engineering Reliable Data Platforms & Applied AI Systems.</h1>
      <p class="hero-lead">
        I am <strong>Pedro Ivo Vasconcelos</strong>, a <strong>Data Engineer</strong> on the Data Platform Engineering team at <strong>Playlist</strong> (formerly Mindbody).
        I specialize in scalable data warehousing (Snowflake, Databricks), automated data pipelines, platform reliability, and autonomous agentic workflows.
      </p>
      <div class="hero-highlights">
        <div class="highlight-chip">
          <strong>~60%</strong> Snowflake storage reduction (CI&T)
        </div>
        <div class="highlight-chip">
          <strong>~30 ms</strong> p95 PostgreSQL latency (CI&T)
        </div>
        <div class="highlight-chip">
          <strong>UFMG</strong> Control & Automation Engineering
        </div>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/resume/">View Resume / CV</a>
        <a class="button button-secondary" href="#projetos">Explore Projects</a>
        <a
          class="button button-secondary"
          href="https://www.linkedin.com/in/pedro-ivo-vasconcelos-bb4632a5/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>

    <StudioCard />
  </div>
</section>
