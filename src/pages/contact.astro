---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Pedro Ivo Vasconcelos | Get in Touch" description="Connect with Pedro Ivo Vasconcelos for Data Platform Engineering, applied AI, or analytical infrastructure opportunities.">
  <main id="conteudo" class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
    <div class="section-heading" style="margin-bottom: 3rem;">
      <p class="eyebrow">Connect</p>
      <h1>Get in Touch</h1>
      <p>
        Always open to discussing data platform architecture, high-throughput pipelines, cloud cost optimization, and applied AI systems.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 2rem; max-width: 52rem;">
      <!-- Direct Channels Card -->
      <article class="card" style="padding: 2.5rem;">
        <h2 style="font-size: 1.35rem; margin-top: 0; margin-bottom: 1.25rem; color: var(--text);">Professional Networks</h2>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem;">
          <li style="display: flex; align-items: flex-start; gap: 1rem;">
            <div style="background: var(--surface-soft); padding: 0.6rem; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </div>
            <div>
              <strong style="color: var(--text); display: block;">LinkedIn</strong>
              <a href="https://www.linkedin.com/in/pedro-ivo-vasconcelos-bb4632a5/" target="_blank" rel="noopener noreferrer" style="color: var(--accent); font-size: 0.95rem; text-decoration: underline;">
                linkedin.com/in/pedro-ivo-vasconcelos-bb4632a5
              </a>
              <p style="color: var(--text-soft); font-size: 0.85rem; margin: 0.25rem 0 0 0;">Fastest channel for recruiter inquiries, recommendations, and direct messages.</p>
            </div>
          </li>

          <li style="display: flex; align-items: flex-start; gap: 1rem;">
            <div style="background: var(--surface-soft); padding: 0.6rem; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
            </div>
            <div>
              <strong style="color: var(--text); display: block;">GitHub</strong>
              <a href="https://github.com/pedroivovasconcelos" target="_blank" rel="noopener noreferrer" style="color: var(--accent); font-size: 0.95rem; text-decoration: underline;">
                github.com/pedroivovasconcelos
              </a>
              <p style="color: var(--text-soft); font-size: 0.85rem; margin: 0.25rem 0 0 0;">Open-source projects, deterministic simulators, WebGL engines, and repositories.</p>
            </div>
          </li>
        </ul>
      </article>

      <!-- Working Details Card -->
      <article class="card" style="padding: 2.5rem;">
        <h2 style="font-size: 1.35rem; margin-top: 0; margin-bottom: 1.25rem; color: var(--text);">Location & Engagement</h2>
        <div style="display: flex; flex-direction: column; gap: 1rem; color: var(--text-soft); font-size: 0.95rem; line-height: 1.6;">
          <div>
            <strong style="color: var(--text); display: block;">📍 Base Location</strong>
            <span>Belo Horizonte, MG, Brazil (UTC-3 / BRT)</span>
          </div>
          <div>
            <strong style="color: var(--text); display: block;">🌐 Work Arrangement</strong>
            <span>Full-time remote collaboration across international engineering teams (US, Europe, Latin America timezones).</span>
          </div>
          <div>
            <strong style="color: var(--text); display: block;">🎯 Focus Areas</strong>
            <span>Data Platform Engineering, Snowflake / Databricks Infrastructure, Pipeline Reliability, Applied AI & MCP tooling.</span>
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>
