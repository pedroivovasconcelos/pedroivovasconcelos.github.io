---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Technical Skills & Competencies — Pedro Ivo Vasconcelos | Data Platforms & Applied AI" description="Technical skill matrix of Pedro Ivo Vasconcelos: Data Platform Engineering, analytical infrastructure, query optimization, reliability, and applied AI.">
  <main id="conteudo" class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
    <div class="section-heading" style="margin-bottom: 3rem;">
      <p class="eyebrow">Technical Matrix</p>
      <h1>Skills & Engineering Capabilities</h1>
      <p>
        Core competencies spanning enterprise data warehousing, high-throughput pipeline engineering, cloud cost governance, and applied AI architectures.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 2rem;">
      <!-- Category 1: Data Platform & Warehousing -->
      <article class="card" style="padding: 2rem;">
        <span class="eyebrow" style="color: var(--accent);">Foundational Infrastructure</span>
        <h2 style="font-size: 1.35rem; margin-top: 0.25rem; margin-bottom: 1rem;">Data Warehousing & Storage</h2>
        <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
          Architecting resilient, scalable analytical platforms with deep query optimization, schema evolution governance, and cloud storage cost efficiency.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <span class="tag">Snowflake</span>
          <span class="tag">Databricks</span>
          <span class="tag">PostgreSQL</span>
          <span class="tag">SQL Server</span>
          <span class="tag">Dimensional Modeling</span>
          <span class="tag">SSIS</span>
          <span class="tag">BigQuery</span>
          <span class="tag">Data Governance</span>
        </div>
      </article>

      <!-- Category 2: Pipelines & Orchestration -->
      <article class="card" style="padding: 2rem;">
        <span class="eyebrow" style="color: var(--accent);">Data Ingestion & Flow</span>
        <h2 style="font-size: 1.35rem; margin-top: 0.25rem; margin-bottom: 1rem;">Pipelines & Transformation</h2>
        <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
          Building robust ETL/ELT pipelines, automated ingestion connectors, and declarative transformations with rigorous type checking and idempotency.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <span class="tag">Python 3.12</span>
          <span class="tag">SQL (Advanced)</span>
          <span class="tag">Fivetran</span>
          <span class="tag">Apache Airflow</span>
          <span class="tag">PySpark</span>
          <span class="tag">dbt</span>
          <span class="tag">Schema Evolution</span>
          <span class="tag">Data Quality Checks</span>
        </div>
      </article>

      <!-- Category 3: Reliability & Performance -->
      <article class="card" style="padding: 2rem;">
        <span class="eyebrow" style="color: var(--accent);">Platform SRE</span>
        <h2 style="font-size: 1.35rem; margin-top: 0.25rem; margin-bottom: 1rem;">Performance & Cost Governance</h2>
        <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
          Empirical optimization of high-load databases, micro-benchmarking query plans, slashing cloud storage overhead, and enforcing SLA guarantees.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <span class="tag">Query Plan Analysis</span>
          <span class="tag">Storage Lifecycle Tuning</span>
          <span class="tag">Index Optimization</span>
          <span class="tag">Table Partitioning</span>
          <span class="tag">CI/CD Pipelines</span>
          <span class="tag">Automated Testing</span>
          <span class="tag">SLA / SLI Monitoring</span>
        </div>
      </article>

      <!-- Category 4: Applied AI & Agentic Systems -->
      <article class="card" style="padding: 2rem;">
        <span class="eyebrow" style="color: var(--accent);">Modern Intelligence</span>
        <h2 style="font-size: 1.35rem; margin-top: 0.25rem; margin-bottom: 1rem;">Applied AI & Agentic Systems</h2>
        <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
          Orchestrating multi-agent architectures, Model Context Protocol (MCP) servers, LLM tool-calling boundaries, and grounded retrieval systems.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <span class="tag">Model Context Protocol (MCP)</span>
          <span class="tag">Autonomous Agents</span>
          <span class="tag">LLM Tool Calling</span>
          <span class="tag">Multi-Agent Control Planes</span>
          <span class="tag">RAG Architectures</span>
          <span class="tag">Deterministic Guardrails</span>
        </div>
      </article>

      <!-- Category 5: Software & Systems Engineering -->
      <article class="card" style="padding: 2rem;">
        <span class="eyebrow" style="color: var(--accent);">Full-Stack & Systems</span>
        <h2 style="font-size: 1.35rem; margin-top: 0.25rem; margin-bottom: 1rem;">Systems & Web Platforms</h2>
        <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
          Engineering end-to-end interactive applications with modern TypeScript, WebGL 3D runtimes, server-side rendering, and high-fidelity UI systems.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <span class="tag">TypeScript</span>
          <span class="tag">Next.js 16</span>
          <span class="tag">React 19</span>
          <span class="tag">Astro</span>
          <span class="tag">Babylon.js (WebGL)</span>
          <span class="tag">Node.js</span>
          <span class="tag">Git & GitHub Actions</span>
          <span class="tag">Linux / Bash / PowerShell</span>
        </div>
      </article>

      <!-- Category 6: Engineering Foundation -->
      <article class="card" style="padding: 2rem;">
        <span class="eyebrow" style="color: var(--accent);">Academic Rigor</span>
        <h2 style="font-size: 1.35rem; margin-top: 0.25rem; margin-bottom: 1rem;">Control & Systems Theory</h2>
        <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
          Rigorous engineering background from Universidade Federal de Minas Gerais (UFMG) in control loops, dynamical systems, and feedback reliability.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <span class="tag">UFMG Engineering</span>
          <span class="tag">Dynamical Systems</span>
          <span class="tag">Control Theory</span>
          <span class="tag">Numerical Methods</span>
          <span class="tag">Mathematical Modeling</span>
          <span class="tag">Feedback Loops</span>
        </div>
      </article>
    </div>
  </main>
</Layout>
