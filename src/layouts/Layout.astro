---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  isErrorPage?: boolean;
  lang?: string;
}

const {
  title,
  description = "Pedro Ivo Vasconcelos — Data Engineer specializing in Data Platforms, Reliability & Applied AI Systems. Data Platform Engineering at Playlist.",
  isErrorPage = false,
  lang = "en"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isPt = lang.startsWith("pt");
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "" || Astro.url.pathname === "/pt-br" || Astro.url.pathname === "/pt-br/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isErrorPage && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b1730" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalURL} />

    {isHome && (
      <>
        <!-- Alternate hreflang tags for homepage bilingual parity -->
        <link rel="alternate" hreflang="en" href="https://pedroivovasconcelos.github.io/" />
        <link rel="alternate" hreflang="pt-BR" href="https://pedroivovasconcelos.github.io/pt-br/" />
        <link rel="alternate" hreflang="x-default" href="https://pedroivovasconcelos.github.io/" />
      </>
    )}

    <!-- OpenGraph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={isPt ? "pt_BR" : "en_US"} />
    <meta property="og:site_name" content="Pedro Ivo Vasconcelos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {!isErrorPage && (
      <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "name": "Pedro Ivo Vasconcelos",
          "jobTitle": "Data Engineer",
          "worksFor": {
            "@type": "Organization",
            "name": "Playlist"
          },
          "alumniOf": {
            "@type": "CollegeOrUniversity",
            "name": "Universidade Federal de Minas Gerais (UFMG)"
          },
          "url": "https://pedroivovasconcelos.github.io/",
          "sameAs": [
            "https://www.linkedin.com/in/pedro-ivo-vasconcelos-bb4632a5/",
            "https://github.com/pedroivovasconcelos"
          ],
          "knowsAbout": [
            "Data Engineering",
            "Data Platform Engineering",
            "Data Warehousing",
            "Snowflake",
            "Databricks",
            "Python",
            "SQL",
            "PostgreSQL",
            "Microsoft SQL Server",
            "Fivetran",
            "Reliability Engineering",
            "Applied AI",
            "Model Context Protocol"
          ]
        }
      </script>
    )}

    <!-- Astro View Transitions Client Router -->
    <ClientRouter />

    <!-- Synchronous Inline FOUC Prevention Script -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'pedro-ivo-theme';
        function readTheme() {
          try {
            const val = localStorage.getItem(STORAGE_KEY);
            if (val === 'light' || val === 'dark') return val;
          } catch (e) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', readTheme());
      })();
    </script>
  </head>
  <body class={isErrorPage ? "error-page" : ""}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header isErrorPage={isErrorPage} lang={lang} />
    <slot />
    <Footer isErrorPage={isErrorPage} lang={lang} />
    <script src="../scripts/theme.js"></script>
  </body>
</html>
